{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-4890-b1c2-d3e4f5a6b7c8",
    "name": "Task Manager AI Chat",
    "description": "AI Chat endpoints for Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ask AI about projects",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has AI reply', function () {",
              "    let jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('response');",
              "    pm.expect(jsonData).to.have.property('user');",
              "});",
              "",
              "pm.test('Response is not empty', function () {",
              "    let jsonData = pm.response.json();",
              "    pm.expect(jsonData.response.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What projects do I have and what are their statuses?\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/ai/chat",
          "host": ["{{base_url}}"],
          "path": ["api", "ai", "chat"]
        }
      }
    },
    {
